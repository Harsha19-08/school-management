# Copy to .env.local (dev) — never commit real secrets.
MONGODB_URI=mongodb://127.0.0.1:27017/schoolhouse
# Optional comma-separated DNS servers for mongodb+srv:// URLs.
MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1
# Set to "true" only if your MongoDB is a replica set / Atlas (enables multi-document transactions).
MONGODB_TRANSACTIONS=false
# Generate with: openssl rand -base64 48
AUTH_SECRET=replace-with-at-least-32-random-characters-xxxxxxxx
APP_URL=http://localhost:3000

# Private file storage (local dev layer). Keep OUTSIDE /public.
STORAGE_DIR=./.storagea
MAX_UPLOAD_MB=10

# Seed (dev/test only; the script refuses NODE_ENV=production and remote databases by default)
SEED_PASSWORD=
# Set to "true" only when you intentionally want to reset a MongoDB Atlas database.
SEED_ALLOW_REMOTE=

# Online payments — leave blank to keep online payment disabled.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Notification providers — blank = in-app only; email/SMS show "not configured".
SMTP_URL=
SMS_API_KEY=
